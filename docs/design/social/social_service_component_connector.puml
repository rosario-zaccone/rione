@startuml

' Version: 1.0.0
' Last modified: 2026-06-30
' Detailed component-and-connector view for the Social Service.

title Social Service - Detailed Component and Connector View

skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

skinparam component {
  BorderColor #2F3A4A
  BackgroundColor #F8FAFC
  FontColor #111827
}

skinparam interface {
  BorderColor #4B5563
  BackgroundColor #FFFFFF
}

skinparam database {
  BorderColor #335C67
  BackgroundColor #E6F4F1
}

skinparam queue {
  BorderColor #7C4A03
  BackgroundColor #FFF4D6
}

skinparam actor {
  BorderColor #374151
  BackgroundColor #F3F4F6
}

actor "Authenticated user" as user
component "API Gateway" as gateway <<external>>
component "Post Service" as postService <<external>>
component "User Service" as userService <<external>>
component "Notification Service" as notificationService <<external>>
component "Prometheus" as prometheus <<external>>
queue "Kafka Broker\nTopic: social" as kafka
database "Social PostgreSQL\nrione-social\n\nTables:\n- neighbor_requests\n- neighborships\n- blocks" as socialDb

package "Social Service" as socialService {
  package "Driving adapters\ninfrastructure.web" {
    component "Security filter chain\nJwtAuthenticationFilter\nSecurityConfig" as security <<adapter>>
    component "SocialController\npublic REST API" as publicController <<adapter>>
    component "InternalSocialController\nservice REST API" as internalController <<adapter>>
    component "CurrentUser\nAuthenticatedPrincipal" as currentUser <<adapter>>
    component "SocialExceptionHandler" as exceptionHandler <<adapter>>
    component "Actuator endpoints\nhealth, prometheus" as actuator <<adapter>>
  }

  package "Application boundary" {
    interface "SocialService\n<<InPort>>" as socialInPort
  }

  package "Application core\napplication.service" {
    component "SocialServiceImpl\nuse-case orchestration" as socialApplication <<application>>
  }

  package "Domain model\ndomain.model" {
    component "NeighborRequest\naggregate root" as neighborRequest <<domain>>
    component "Neighborship\naggregate root" as neighborship <<domain>>
    component "Block\naggregate root" as block <<domain>>
    component "Value objects\nUserId, NeighborRequestId,\nNeighborshipId, BlockId" as valueObjects <<domain>>
    component "RequestStatus\nDomainException" as domainSupport <<domain>>
  }

  package "Output ports\napplication.port.out" {
    interface "NeighborRequestRepository\n<<OutPort>>" as neighborRequestRepositoryPort
    interface "NeighborshipRepository\n<<OutPort>>" as neighborshipRepositoryPort
    interface "BlockRepository\n<<OutPort>>" as blockRepositoryPort
    interface "NeighborhoodMembership\n<<OutPort>>" as neighborhoodMembershipPort
    interface "UserDirectory\n<<OutPort>>" as userDirectoryPort
    interface "SocialEventPublisher\n<<OutPort>>" as socialEventPublisherPort
  }

  package "Driven adapters\ninfrastructure.persistence" {
    component "JpaNeighborRequestRepositoryAdapter" as neighborRequestJpaAdapter <<adapter>>
    component "JpaNeighborshipRepositoryAdapter" as neighborshipJpaAdapter <<adapter>>
    component "JpaBlockRepositoryAdapter" as blockJpaAdapter <<adapter>>
    component "Spring Data JPA repositories\nand JPA entities" as springDataJpa <<adapter>>
  }

  package "Driven adapters\ninfrastructure.proxy" {
    component "UserServiceProxy\nRestClient + service JWT" as userServiceProxy <<adapter>>
  }

  package "Driven adapters\ninfrastructure.messaging" {
    component "KafkaSocialEventPublisher\nKafkaTemplate + ObjectMapper" as kafkaPublisher <<adapter>>
  }

  package "Configuration\ninfrastructure.config" {
    component "JwtService\nservice token creation/parsing" as jwtService <<adapter>>
    component "RestClientConfiguration" as restClientConfig <<adapter>>
    component "KafkaProducerConfiguration" as kafkaProducerConfig <<adapter>>
  }
}

user --> gateway : HTTPS/REST
gateway --> security : HTTP/REST\npublic social routes
postService --> security : HTTP/REST\nGET /internal/social/post-visibility\nservice JWT
prometheus --> actuator : HTTP scrape\n/actuator/prometheus

security --> publicController : authenticated user request
security --> internalController : authenticated service request
security --> jwtService : parse bearer token
publicController --> currentUser : resolve actor
publicController --> socialInPort : commands and queries
internalController --> socialInPort : PostVisibilityQuery
exceptionHandler ..> publicController : maps exceptions
exceptionHandler ..> internalController : maps exceptions

socialInPort <|.. socialApplication : implements

socialApplication --> neighborRequest : create, accept, reject
socialApplication --> neighborship : create, validate, counterpart
socialApplication --> block : create, validate
socialApplication --> valueObjects : wraps identifiers
socialApplication --> domainSupport : uses status and domain errors

socialApplication --> neighborRequestRepositoryPort : save/find/delete requests
socialApplication --> neighborshipRepositoryPort : save/find/delete relationships
socialApplication --> blockRepositoryPort : save/find/delete blocks
socialApplication --> neighborhoodMembershipPort : sameNeighborhood
socialApplication --> userDirectoryPort : search and load profiles
socialApplication --> socialEventPublisherPort : publish request events

neighborRequestRepositoryPort <|.. neighborRequestJpaAdapter : implements
neighborshipRepositoryPort <|.. neighborshipJpaAdapter : implements
blockRepositoryPort <|.. blockJpaAdapter : implements
neighborRequestJpaAdapter --> springDataJpa : delegates
neighborshipJpaAdapter --> springDataJpa : delegates
blockJpaAdapter --> springDataJpa : delegates
springDataJpa --> socialDb : JDBC/JPA

neighborhoodMembershipPort <|.. userServiceProxy : implements
userDirectoryPort <|.. userServiceProxy : implements
userServiceProxy --> restClientConfig : uses RestClient.Builder
userServiceProxy --> jwtService : creates service token
userServiceProxy --> userService : HTTP/REST\n/internal/users/{id}/neighborhood\n/internal/users/search\n/internal/users/profiles

socialEventPublisherPort <|.. kafkaPublisher : implements
kafkaPublisher --> kafkaProducerConfig : uses KafkaTemplate
kafkaPublisher --> kafka : publish\nREQUEST_RECEIVED\nREQUEST_ACCEPTED
kafka --> notificationService : consumed by\nSocialEventListener

note right of socialApplication
  Use cases:
  - search users in neighborhood
  - send, accept, reject neighbor requests
  - list sent and received requests
  - list and remove neighborships
  - create, list, and remove blocks
  - check post visibility for Post Service
  - reconcile relationships after neighborhood change
end note

note bottom of socialService
  Hexagonal dependency rule:
  web, proxy, messaging, and persistence adapters connect through ports.
  The application core depends on domain objects and output-port interfaces,
  not on concrete infrastructure components.
end note

legend right
  == Connector labels ==
  HTTP/REST: synchronous request/response
  JDBC/JPA: persistence connector
  publish/consume: asynchronous Kafka connector
  InPort: driving adapter to application boundary
  OutPort: application boundary to driven adapter
endlegend

@enduml
