@startuml

' Version: 1.0.0
' Last modified: 2026-06-30
' Component-and-connector backend view for the Rione application.

title Rione Backend - Component and Connector View

skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

skinparam component {
  BorderColor #2F3A4A
  BackgroundColor #F8FAFC
  FontColor #111827
}

skinparam database {
  BorderColor #335C67
  BackgroundColor #E6F4F1
}

skinparam queue {
  BorderColor #7C4A03
  BackgroundColor #FFF4D6
}

skinparam cloud {
  BorderColor #5B5F97
  BackgroundColor #EEF0FF
}

actor "Web Client" as client

package "Rione backend" {
  component "API Gateway\nSpring Cloud Gateway MVC" as gateway <<gateway>>

  component "User Service\nSpring Boot" as userService <<microservice>> {
    component "Web adapter\nusers, cities, internal users" as userWeb <<adapter>>
    component "Application core\nUserService, CityService" as userCore <<core>>
    component "Persistence adapter\nUserRepository, CityRepository" as userPersistence <<adapter>>
  }

  component "Social Service\nSpring Boot" as socialService <<microservice>> {
    component "Web adapter\nneighbor requests, neighborships, blocks" as socialWeb <<adapter>>
    component "Application core\nSocialService" as socialCore <<core>>
    component "Persistence adapter\nsocial repositories" as socialPersistence <<adapter>>
    component "User service proxy\nUserDirectory, NeighborhoodMembership" as socialUserProxy <<adapter>>
    component "Kafka publisher\nSocialEventPublisher" as socialKafkaPublisher <<adapter>>
  }

  component "Post Service\nSpring Boot" as postService <<microservice>> {
    component "Web adapter\nposts, comments, reactions" as postWeb <<adapter>>
    component "Application core\nPostService" as postCore <<core>>
    component "Event store adapter\nPostEventStore" as postEventStoreAdapter <<adapter>>
    component "User service proxy\nPostUserDirectory" as postUserProxy <<adapter>>
    component "Social service proxy\nPostVisibilityChecker" as postSocialProxy <<adapter>>
    component "Kafka publisher\nPostNotificationPublisher" as postKafkaPublisher <<adapter>>
  }

  component "Notification Service\nSpring Boot" as notificationService <<microservice>> {
    component "Web adapter\nnotifications" as notificationWeb <<adapter>>
    component "Application core\nNotificationService" as notificationCore <<core>>
    component "Persistence adapter\nNotificationRepository" as notificationPersistence <<adapter>>
    component "Kafka listeners\nsocial and post events" as notificationKafkaListeners <<adapter>>
  }

  queue "Kafka Broker\nTopics: social, post" as kafka

  database "User PostgreSQL\nrione-users" as userDb
  database "Social PostgreSQL\nrione-social" as socialDb
  database "Post PostgreSQL\nrione-post" as postDb
  database "Notification PostgreSQL\nrione-notification" as notificationDb
}

package "Observability" {
  component "Prometheus" as prometheus
  component "Grafana" as grafana
}

client --> gateway : HTTPS/REST\npublic API

gateway --> userWeb : HTTP/REST\n/users, /cities
gateway --> socialWeb : HTTP/REST\n/social, /me, /neighbor-requests
gateway --> postWeb : HTTP/REST\n/posts, /me/posts, /users/{id}/posts
gateway --> notificationWeb : HTTP/REST\n/notifications

userWeb --> userCore : input ports
userCore --> userPersistence : output ports
userPersistence --> userDb : JDBC/JPA

socialWeb --> socialCore : input ports
socialCore --> socialPersistence : output ports
socialPersistence --> socialDb : JDBC/JPA
socialCore --> socialUserProxy : output ports
socialUserProxy --> userWeb : HTTP/REST\nservice JWT
socialCore --> socialKafkaPublisher : output port
socialKafkaPublisher --> kafka : publish\nsocial topic

postWeb --> postCore : input ports
postCore --> postEventStoreAdapter : output port
postEventStoreAdapter --> postDb : JDBC/JPA\nevent stream and ids
postCore --> postUserProxy : output port
postUserProxy --> userWeb : HTTP/REST\nservice JWT
postCore --> postSocialProxy : output port
postSocialProxy --> socialWeb : HTTP/REST\nservice JWT
postCore --> postKafkaPublisher : output port
postKafkaPublisher --> kafka : publish\npost topic

kafka --> notificationKafkaListeners : consume\nsocial and post topics
notificationKafkaListeners --> notificationCore : input port
notificationWeb --> notificationCore : input port
notificationCore --> notificationPersistence : output port
notificationPersistence --> notificationDb : JDBC/JPA

prometheus --> gateway : scrape\n/actuator/prometheus
prometheus --> userService : scrape\n/actuator/prometheus
prometheus --> socialService : scrape\n/actuator/prometheus
prometheus --> postService : scrape\n/actuator/prometheus
prometheus --> notificationService : scrape\n/actuator/prometheus
grafana --> prometheus : query metrics

note bottom of userService
  Internal dependency direction follows the hexagonal boundary:
  web/messaging/proxy/persistence adapters depend on application ports,
  while the application core stays independent from infrastructure.
end note

legend right
  == Connector labels ==
  HTTP/REST: synchronous request/response connector
  JDBC/JPA: persistence connector
  publish/consume: asynchronous Kafka connector
  input/output ports: hexagonal application boundary
endlegend

@enduml
